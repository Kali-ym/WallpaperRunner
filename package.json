{
  "name": "wallpaperrunner",
  "version": "1.0.0",
  "description": "WallpaperRunner — 壁纸下载、本地图库与 Wallpaper Engine 轮播",
  "main": "./out/main/index.js",
  "author": "WallpaperRunner",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "node scripts/build-icon.mjs",
    "build": "electron-vite build",
    "build:icon": "node scripts/build-icon.mjs",
    "prebuild": "node scripts/build-icon.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:win": "npm run build && electron-builder --win nsis --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "7zip-bin": "^5.2.0",
    "cheerio": "^1.1.2",
    "node-unrar-js": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "telegram": "^2.26.22",
    "undici": "^8.10.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.6.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "png-to-ico": "^3.0.2",
    "tsx": "^4.23.11",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  },
  "build": {
    "appId": "com.wallpaperrunner.app",
    "productName": "WallpaperRunner",
    "copyright": "Copyright © 2026 WallpaperRunner",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WallpaperRunner",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.photography"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "publish": null
  }
}
